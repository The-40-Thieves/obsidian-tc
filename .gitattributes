# Normalize all text files to LF in the repo and on checkout (all platforms).
# Biome formats to LF; without this, Windows checkouts get CRLF and lint fails.
* text=auto eol=lf

# Binary files: never normalize.
*.node binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
bun.lock -text

# Generated file that stays committed: it is compiled into the standalone binaries, which cannot
# read .sql from disk. Two PRs that each add a migration both append to the same object literal, so
# a text merge can only conflict. `merge=regen` names the `regen` driver
# (scripts/merge-drivers/regen.mjs), which merges the three versions as DATA (filename -> SQL) and
# re-renders through the generator's own renderer. Only a LOCAL `git merge` / `git rebase` runs it:
# GitHub's server-side mergeability check ignores .gitattributes merge drivers entirely. The
# driver's definition lives in this clone's git config, set by scripts/setup-git-merge-driver.mjs
# (runs automatically via `bun install`'s `prepare` script); scripts/check-merge-driver.mjs asserts
# it took, because a .gitattributes-only change is silently vacuous.
packages/server/src/db/migrations-embedded.ts merge=regen

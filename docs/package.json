{
  "name": "obsidian-tc-docs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "gen:regions": "bun ../packages/server/scripts/docgen/render.ts",
    "gen:decisions-index": "cd .. && node scripts/gen-decisions-index.mjs",
    "gen:tool-pages": "bun ../packages/server/scripts/docgen/tool-pages.ts",
    "gen": "bun run gen:regions && bun run gen:decisions-index && bun run gen:tool-pages",
    "check:tool-pages": "bun ../packages/server/scripts/docgen/tool-pages.ts --check --dist dist",
    "dev": "bun run gen && astro dev",
    "start": "bun run gen && astro dev",
    "build": "bun run gen && astro check && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/starlight": "^0.42.5",
    "astro": "^7.3.7",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "fast-uri": ">=3.1.8 <4",
    "js-yaml": ">=4.3.1 <5",
    "nanoid": ">=3.3.17 <4",
    "postcss": ">=8.5.23 <9",
    "postcss-selector-parser": ">=7.1.6 <8",
    "sharp": ">=0.35.0 <0.36",
    "svgo": ">=4.0.2 <5",
    "yaml": ">=2.8.3 <3"
  }
}

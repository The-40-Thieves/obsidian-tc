{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/server": {
      "entry": [
        "src/index.ts",
        "src/cli.ts",
        "scripts/**/*.{ts,mjs}",
        "eval/**/*.ts",
        "bun-smoke/**/*.ts",
        "perf/**/*.ts",
        "test/**/*.{ts,bun.ts}"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "eval/**/*.ts", "bun-smoke/**/*.ts"]
    },
    "packages/shared": { "entry": ["src/index.ts"], "project": ["src/**/*.ts"] },
    "packages/plugin": { "entry": ["src/main.ts"], "project": ["src/**/*.ts"] },
    "packages/native": { "entry": ["index.js", "fallback.ts"], "project": ["*.{ts,js}"] },
    ".": { "entry": ["scripts/**/*.mjs"], "project": ["scripts/**/*.mjs"] }
  },
  "ignore": ["docs/**", "**/dist/**", "**/target/**", "services/**"],
  "ignoreDependencies": ["@types/*"],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": false
}

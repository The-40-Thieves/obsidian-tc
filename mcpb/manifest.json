{
  "manifest_version": "0.3",
  "name": "reliquary-tc",
  "display_name": "Reliquary-TC",
  "version": "2.0.0",
  "description": "Governed Obsidian vault access: hybrid retrieval, Markdown-native memory, HITL confirmations.",
  "author": {
    "name": "The 40 Thieves",
    "url": "https://github.com/The-40-Thieves"
  },
  "homepage": "https://github.com/The-40-Thieves/reliquary-tc#readme",
  "documentation": "https://github.com/The-40-Thieves/reliquary-tc#readme",
  "support": "https://github.com/The-40-Thieves/reliquary-tc/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-40-Thieves/reliquary-tc"
  },
  "keywords": [
    "obsidian",
    "obsidian-vault",
    "mcp",
    "model-context-protocol",
    "knowledge-management",
    "semantic-search",
    "retrieval",
    "memory",
    "markdown",
    "agent",
    "rbac"
  ],
  "server": {
    "type": "node",
    "entry_point": "packages/server/dist/cli.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/packages/server/dist/cli.js", "${user_config.config_path}"],
      "env": {
        "RELIQUARY_TC_DEFAULT_VAULT": "${user_config.default_vault}"
      }
    }
  },
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=24.0.0"
    }
  },
  "user_config": {
    "config_path": {
      "type": "file",
      "title": "Config file",
      "description": "A reliquary-tc JSON config file, or a vault folder path (zero-config) typed or pasted here; a file picker cannot select a folder.",
      "required": true
    },
    "default_vault": {
      "type": "string",
      "title": "Default vault id",
      "description": "Vault id to bind tool calls to when a request omits one. Leave blank to use the first configured vault.",
      "required": false
    }
  }
}

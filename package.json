{
  "name": "obsidian-tc-monorepo",
  "version": "1.23.4",
  "private": true,
  "description": "Obsidian Turbocharged — comprehensive, model-agnostic, agent-ready Obsidian MCP server",
  "license": "AGPL-3.0-only",
  "author": "The 40 Thieves",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-40-Thieves/obsidian-tc.git"
  },
  "homepage": "https://github.com/The-40-Thieves/obsidian-tc#readme",
  "bugs": {
    "url": "https://github.com/The-40-Thieves/obsidian-tc/issues"
  },
  "workspaces": [
    "packages/server",
    "packages/plugin",
    "packages/native",
    "packages/shared"
  ],
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "scripts": {
    "build": "bun run --filter='*' build",
    "bundle": "bun scripts/bundle-mcpb.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:comment-style": "node scripts/check-comment-style.mjs",
    "check:config-paths": "node scripts/check-config-paths.mjs",
    "check:dev-dep-imports": "node scripts/check-dev-dep-imports.mjs",
    "check:duplicate-exports": "node scripts/check-duplicate-exports.mjs",
    "check:duplication": "jscpd --config .jscpd.json",
    "check:embedding-transport": "node scripts/check-embedding-transport-vendor-neutral.mjs",
    "check:export-surface": "node scripts/check-export-surface.mjs",
    "check:facade-parity": "node scripts/check-facade-parity.mjs",
    "check:ingest-telemetry-wiring": "node scripts/check-ingest-telemetry-wiring.mjs",
    "check:merge-driver": "node scripts/check-merge-driver.mjs",
    "check:nul": "node scripts/check-nul-bytes.mjs",
    "check:table-readers": "node scripts/check-table-readers.mjs",
    "check:perf-timing-scope": "node scripts/check-perf-timing-scope.mjs",
    "check:plugin-routes": "node scripts/check-plugin-routes.mjs",
    "check:version": "node scripts/check-version-coherence.mjs",
    "check:workflow-injection": "node scripts/check-workflow-injection.mjs",
    "config:schema": "bun scripts/gen-config-schema.ts",
    "config:schema:check": "bun scripts/gen-config-schema.ts --check",
    "docs:decisions-index": "node scripts/gen-decisions-index.mjs",
    "docs:decisions-index:check": "node scripts/gen-decisions-index.mjs --check",
    "format": "biome format --write .",
    "lint": "biome check --error-on-warnings .",
    "knip": "knip",
    "map": "node scripts/gen-tree-map.mjs",
    "map:check": "node scripts/gen-tree-map.mjs --check",
    "migrations:embed": "node scripts/gen-embedded-migrations.mjs",
    "migrations:embed:check": "node scripts/gen-embedded-migrations.mjs --check",
    "prepare": "node scripts/setup-git-merge-driver.mjs && node scripts/setup-dco-hook.mjs",
    "release": "bun scripts/release.mjs",
    "setup:dco-hook": "node scripts/setup-dco-hook.mjs",
    "setup:git-merge-driver": "node scripts/setup-git-merge-driver.mjs",
    "test": "bun run --filter='*' test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "bun run --filter='*' typecheck",
    "where": "node scripts/where-symbol.mjs",
    "migration-impact": "node scripts/migration-impact.mjs",
    "vec:embed": "node scripts/gen-embedded-vec.mjs",
    "db:pages": "node scripts/db-page-report.mjs"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.0",
    "@biomejs/biome": "^2.5.5",
    "dependency-cruiser": "18.1.0",
    "jscpd": "^5.0.12",
    "knip": "6.32.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@hono/node-server": ">=2.0.10 <3",
    "brace-expansion": ">=5.0.8 <6",
    "fast-uri": ">=3.1.5 <4",
    "hono": ">=4.12.34 <5",
    "ip-address": ">=10.3.1 <11",
    "js-yaml": ">=4.3.1 <5",
    "minimatch": ">=10.2.5 <11",
    "nanoid": ">=3.3.17 <4",
    "postcss": ">=8.5.18 <9",
    "vite": "^7.0.0"
  }
}

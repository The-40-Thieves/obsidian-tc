{
  "name": "@the-40-thieves/reliquary-tc-embedder-local",
  "version": "2.0.1",
  "description": "Optional bundled dense embedder for reliquary-tc — runs fully offline, CPU-only, via @huggingface/transformers, no gateway or Ollama required",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fetch-model": "bun scripts/fetch-model.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-40-Thieves/reliquary-tc.git",
    "directory": "packages/embedder-local"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "adm-zip": "^0.6.0",
    "sharp": "^0.35.0"
  }
}

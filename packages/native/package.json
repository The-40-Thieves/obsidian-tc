{
  "name": "@the-40-thieves/reliquary-tc-native",
  "version": "2.0.1",
  "description": "Native perf module for reliquary-tc — vector ops, BM25, sqlite-vec, V2 clustering hooks",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "fallback.js",
    "*.node",
    "LICENSE",
    "NOTICE"
  ],
  "napi": {
    "binaryName": "reliquary-tc-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "bun scripts/build.mjs --release",
    "build:debug": "bun scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "cargo test",
    "test:build-script": "vitest run",
    "version": "napi version"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^26.6.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/The-40-Thieves/reliquary-tc.git",
    "directory": "packages/native"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  }
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "moduleResolution": "Bundler"
  },
  // `test` and the vitest config are included so `bun run typecheck` actually covers them. With
  // "src" alone the tests are TypeScript that nothing typechecks — the suite would still run,
  // because vitest transpiles without type-checking, so a broken type in a test surfaces as
  // nothing at all.
  "include": ["src", "test", "legacy", "vitest.config.ts"]
}

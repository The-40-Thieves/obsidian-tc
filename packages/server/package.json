{
  "name": "obsidian-tc",
  "version": "1.19.0",
  "description": "MCP server for Obsidian — comprehensive tool surface for humans and autonomous agents",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "obsidian-tc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SKILLS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target node --external better-sqlite3 --minify --sourcemap=linked && bun scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.bun-smoke.json",
    "test": "vitest run",
    "smoke:live": "vitest run test/live-companion.test.ts",
    "test:acl-audit": "OBSIDIAN_TC_ACL_AUDIT=strict vitest run test/attachment-tools-branch-coverage.test.ts test/periodic-tools-branch-coverage.test.ts test/the-567-periodic-memory-scope.test.ts test/dispatch-guards.test.ts test/vault-arg-dispatch.test.ts test/acl-extraction-coverage.test.ts test/acl-audit.test.ts",
    "test:coverage": "vitest run --coverage",
    "dev": "bun run --watch ./src/index.ts",
    "docgen:model": "bun scripts/docgen/build-model.ts",
    "docgen:render": "bun scripts/docgen/render.ts",
    "docgen:suggest": "bun scripts/docgen/suggest-prose.ts",
    "docgen:sync-facts": "bun scripts/docgen/sync-facts.ts",
    "docgen:facts-check": "bun scripts/docgen/facts-check.ts",
    "docgen:error-envelope": "bun scripts/docgen/check-error-envelope.ts",
    "perf": "bun eval/perf/run.ts --scenario small --out perf-report.json",
    "perf:gate": "bun eval/perf/run.ts --scenario small --out perf-report.json --gate",
    "perf:isolated": "bun eval/perf/run.ts --scenario small --samples 5 --out perf-report.json",
    "perf:gate:isolated": "bun eval/perf/run.ts --scenario small --samples 5 --out perf-report.json --gate",
    "perf:update-baseline:isolated": "bun eval/perf/run.ts --scenario small --samples 5 --out perf-report.json --update-baseline",
    "perf:gate:densify:isolated": "bun eval/perf/run.ts --scenario densify --samples 5 --out perf-report-densify.json --gate",
    "perf:colbert": "bun eval/perf/run.ts --scenario colbert --samples 5 --out perf-report-colbert.json",
    "perf:node-parity": "bun build eval/perf/run.ts --target node --external better-sqlite3 --outfile eval/perf/.node-parity.mjs && node eval/perf/.node-parity.mjs --scenario small --profile portable --out perf-node-parity.json",
    "test:local": "../../scripts/with-host-budget.sh node ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@the-40-thieves/obsidian-tc-native": "workspace:*",
    "@the-40-thieves/obsidian-tc-shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.12.34",
    "jose": "^6.2.3",
    "prom-client": "^15.1.3",
    "sqlite-vec": "^0.1.9",
    "systeminformation": "^5.33.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "model-context-protocol",
    "knowledge-management",
    "agent",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/The-40-Thieves/obsidian-tc.git",
    "directory": "packages/server"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24"
  }
}
